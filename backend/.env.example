# Copy this file to .env and fill in your own values.

SECRET_KEY=change-this-to-a-random-secret-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL — create this database first (see README), then fill in your own credentials
DB_NAME=vignesh_portfolio
DB_USER=root
DB_PASSWORD=12345678
DB_HOST=localhost
DB_PORT=3306

# Origins allowed to call this API (the Vite dev server, by default)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
